{"ieHTML":"<div class=\"img-editor\" id=\"imgEditor\" hidden>\n    <div class=\"ie-modal\">\n      <div class=\"ie-head\"><h2>Editor</h2><button class=\"ie-close\" id=\"ieClose\"><i class=\"fa-solid fa-xmark\"></i></button></div>\n      <div class=\"ie-body\">\n        <div class=\"ie-main\"><img id=\"ieMain\" alt=\"\"></div>\n        <div class=\"ie-side\">\n          <div class=\"ie-count\" id=\"ieCount\"></div>\n          <div class=\"ie-thumbs\" id=\"ieThumbs\"></div>\n          <div class=\"ie-tools\"><button id=\"ieDup\" title=\"Duplicar\"><i class=\"fa-regular fa-copy\"></i></button><button id=\"ieDel\" title=\"Excluir\"><i class=\"fa-regular fa-trash-can\"></i></button><button id=\"ieAdd\" title=\"Adicionar\" class=\"round\"><i class=\"fa-solid fa-plus\"></i></button></div>\n        </div>\n      </div>\n      <div class=\"ie-foot\"><button class=\"nv-wbtn primary\" id=\"ieDone\">Avançar</button></div>\n      <input type=\"file\" id=\"ieFile\" accept=\"image/*\" multiple hidden>\n    </div>\n  </div>"}